# ===========================================================================
# PomAss backend — variables de entorno (ejemplo). Copia a .env y ajusta.
# NUNCA subas el .env real al repositorio.
# ===========================================================================

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Nº de saltos de proxy de confianza. Local: 0. Detrás de un ALB/CloudFront: 1.
TRUST_PROXY=0

# Base de datos (Postgres). En docker-compose el host es "db".
DATABASE_URL=postgresql://pomass:pomass_pass@localhost:5432/pomass?schema=public

# Redis. En docker-compose el host es "redis".
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL=15m
# El refresh token es opaco (bytes aleatorios hasheados en BD), no un JWT: solo necesita TTL.
JWT_REFRESH_TTL=7d

# Seguridad
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TTL_MIN=30
# En producción NO uses "*": lista los orígenes permitidos separados por coma.
CORS_ORIGIN=http://localhost:5173

# Envío (checkout)
SHIPPING_FLAT_RATE=12900
FREE_SHIPPING_THRESHOLD=150000

# Pagos: secreto HMAC-SHA256 para verificar los webhooks.
# ⚠️ En producción DEBE cambiarse: el valor por defecto permite falsificar pagos.
PAYMENTS_WEBHOOK_SECRET=dev_webhook_secret_change_me

# Credenciales de Postgres para docker-compose
POSTGRES_USER=pomass
POSTGRES_PASSWORD=pomass_pass
POSTGRES_DB=pomass

# Seed: usuario admin inicial
# ⚠️ En producción DEBE cambiarse: el valor por defecto es una credencial conocida.
ADMIN_EMAIL=admin@pomass.co
ADMIN_PASSWORD=Admin123*

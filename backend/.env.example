# ===========================================================================
# PomAss backend — variables de entorno (ejemplo). Copia a .env y ajusta.
# NUNCA subas el .env real al repositorio.
# ===========================================================================

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Nº de saltos de proxy de confianza. Local: 0. Detrás de un ALB/CloudFront: 1.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Base de datos (Postgres). En docker-compose el host es "db".
#
# EN SUPABASE se usan DOS cadenas distintas, y no son intercambiables:
#
#   DATABASE_URL -> pooler de TRANSACCIÓN, puerto 6543
#     aws-<región>.pooler.supabase.com:6543
#     Debe llevar `?pgbouncer=true`: sin él Prisma usa sentencias preparadas,
#     que el pooler en modo transacción no soporta, y falla en caliente.
#
#   DIRECT_URL -> conexión que SÍ admite DDL, solo para migraciones
#     Opción A (IPv6):  db.<ref>.supabase.co:5432        conexión directa
#     Opción B (IPv4):  aws-<región>.pooler.supabase.com:5432   pooler de sesión
#     Usa la B si tu red o tu proveedor no tienen IPv6: la conexión directa de
#     Supabase es solo IPv6 salvo que contrates el complemento de IPv4.
#
# Ambas cadenas llevan la contraseña de la base: nunca las subas al repo.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://pomass:pomass_pass@localhost:5432/pomass?schema=public
DIRECT_URL=postgresql://pomass:pomass_pass@localhost:5432/pomass?schema=public

# Redis. En docker-compose el host es "redis".
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL=15m
# El refresh token es opaco (bytes aleatorios hasheados en BD), no un JWT: solo necesita TTL.
JWT_REFRESH_TTL=7d

# Seguridad
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TTL_MIN=30
# En producción NO uses "*": lista los orígenes permitidos separados por coma.
CORS_ORIGIN=http://localhost:5173

# Envío (checkout)
SHIPPING_FLAT_RATE=12900
FREE_SHIPPING_THRESHOLD=150000

# ---------------------------------------------------------------------------
# Pagos — Wompi (https://comercios.wompi.co)
# Las cuatro credenciales salen del panel de Wompi. Empieza con las de sandbox
# (pub_test_/prv_test_) y cámbialas por las de producción al lanzar.
# ---------------------------------------------------------------------------
# Llave pública: viaja al navegador para inicializar el widget. No es secreta.
WOMPI_PUBLIC_KEY=pub_test_000000000000000000000000
# Llave privada: solo para consultar transacciones contra la API de Wompi.
WOMPI_PRIVATE_KEY=prv_test_000000000000000000000000
# ⚠️ Secreto de integridad: firma el monto que consume el widget.
# Con el valor por defecto, cualquiera podría alterar el importe del cobro.
WOMPI_INTEGRITY_SECRET=dev_wompi_integrity_change_me
# ⚠️ Secreto de eventos: verifica el checksum de los webhooks.
# Con el valor por defecto, cualquiera podría falsificar una confirmación de pago.
WOMPI_EVENTS_SECRET=dev_wompi_events_change_me
# A dónde vuelve el cliente tras pagar. Debe apuntar al frontend.
WOMPI_REDIRECT_URL=http://localhost:5173/track.html

# Credenciales de Postgres para docker-compose
POSTGRES_USER=pomass
POSTGRES_PASSWORD=pomass_pass
POSTGRES_DB=pomass

# Seed: usuario admin inicial
# ⚠️ En producción DEBE cambiarse: el valor por defecto es una credencial conocida.
ADMIN_EMAIL=admin@pomass.co
ADMIN_PASSWORD=Admin123*

# ---- Correo transaccional (Resend) ----
# Sin la llave NO se envía ningún correo: quedan escritos en el log. Cómodo en
# desarrollo; en producción la tienda arranca igual pero avisa a gritos, y las
# clientas no reciben confirmación ni aviso de envío.
# Se saca de https://resend.com → API Keys.
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend o el envío se rechaza.
# Para probar sin dominio propio sirve el de pruebas de Resend:
EMAIL_FROM=PomAss <onboarding@resend.dev>
# Dirección pública de la tienda. De aquí salen los enlaces de los correos
# (seguimiento del pedido y cambio de contraseña). En producción NO puede
# quedar en localhost: el arranque falla si se intenta.
FRONTEND_URL=http://localhost:5173

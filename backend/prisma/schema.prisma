// ============================================================================
// PomAss · Tienda virtual de cremas íntimas — Modelo de datos (PROPUESTA)
// PostgreSQL + Prisma. Dinero en Decimal(12,2), moneda por defecto COP.
// NOTA: Este archivo es una propuesta para validar antes de generar el código.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión agrupada (PgBouncer, puerto 6543 en Supabase). Es la que usa la app.
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432). Solo la usan las migraciones: el pooler en
  // modo transacción no soporta bien los comandos DDL. En local ambas pueden
  // apuntar a la misma base.
  directUrl = env("DIRECT_URL")
}

// ------------------------------ Enums --------------------------------------

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING // pendiente (creado, sin pagar)
  PAID // pagado
  PREPARING // en preparación
  SHIPPED // enviado
  DELIVERED // entregado
  CANCELLED // cancelado
}

// Mercado Pago es un único proveedor que internamente ofrece varios medios
// (tarjeta, PSE, Efecty, saldo). El medio concreto que eligió la clienta llega
// en el pago que se consulta tras el webhook y se guarda en
// `Payment.rawPayload`, no se modela aquí.
enum PaymentMethod {
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
}

enum CouponType {
  PERCENTAGE // value = % (0-100)
  FIXED // value = monto fijo en COP
}

// ------------------------------ Usuarios -----------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role     @default(CLIENT)
  ageConfirmed  Boolean  @default(false) // declaración "soy mayor de 18"; obligatoria en el registro
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]
  couponRedemptions CouponRedemption[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // se guarda hasheado, nunca en claro
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  department String // departamento (Colombia)
  postalCode String?
  country    String   @default("CO")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ------------------------------ Catálogo -----------------------------------

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String? // subcategorías (self-relation)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  sku          String   @unique
  description  String
  brandId      String
  categoryId   String
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("COP")
  presentation String? // p.ej. "Tubo 50 ml"
  sizeMl       Int? // volumen para filtros
  usageType    String? // uso: lubricante, hidratante, higiene, post-depilación...
  skinType     String? // tipo de piel: sensible, normal, todo tipo...
  ingredients  String? // composición
  warnings     String? // advertencias de uso
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand    Brand          @relation(fields: [brandId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  reviews  Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([name]) // apoyo a la búsqueda por nombre
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ------------------------------ Carrito ------------------------------------
// Carrito persistente por usuario en Postgres.
// Los carritos de INVITADO viven en Redis (efímeros) y se fusionan al iniciar sesión.

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ------------------------------ Cupones ------------------------------------

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  minPurchase  Decimal?   @db.Decimal(12, 2) // monto mínimo de compra
  maxUses      Int? // usos totales; null = ilimitado
  usedCount    Int        @default(0)
  perUserLimit Int? // usos por usuario; null = sin límite / 1 = uso único
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ------------------------------ Pedidos ------------------------------------

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique // legible: PA-2026-000123
  userId            String? // null = pedido de invitado (checkout sin cuenta)
  addressId         String?
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(12, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal     @default(0) @db.Decimal(12, 2)
  total             Decimal     @db.Decimal(12, 2)
  currency          String      @default("COP")
  couponId          String?
  discreetPackaging Boolean     @default(false) // empaque discreto sin marca visible
  // snapshot de la dirección de envío (por si la dirección cambia luego)
  shipFullName      String?
  shipPhone         String?
  shipLine1         String?
  shipLine2         String?
  shipCity          String?
  shipDepartment    String?
  shipPostalCode    String?
  guestEmail        String? // correo de contacto cuando el pedido es de invitado
  // Rastreo del envío. Nullables: un pedido solo tiene guía a partir de SHIPPED.
  carrier           String? // transportadora (Servientrega, Interrapidísimo, …)
  trackingNumber    String? // número de guía que el cliente usa para rastrear
  placedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  address  Address?    @relation(fields: [addressId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  payments Payment[]
  reviews  Review[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String // snapshot del nombre al momento de la compra
  unitPrice   Decimal @db.Decimal(12, 2) // snapshot del precio
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ------------------------------ Pagos --------------------------------------

model Payment {
  id     String        @id @default(uuid())
  orderId String
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(12, 2)
  currency String      @default("COP")
  // Referencia que ve la pasarela. Es el `orderNumber` del pedido: es lo que
  // viaja a Mercado Pago como `external_reference` y lo que devuelve el pago
  // consultado tras el webhook.
  externalReference String?
  // Id del pago en la pasarela. Llega con el webhook, no antes.
  providerTransactionId String?
  rawPayload Json? // payload del webhook para trazabilidad
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalReference])
  @@index([providerTransactionId])
  @@map("payments")
}

// ------------------------------ Reseñas ------------------------------------

model Review {
  id          String   @id @default(uuid())
  productId   String
  userId      String
  orderId     String? // vínculo a la compra que habilita la reseña
  rating      Int // 1..5 (validado en la app)
  title       String?
  comment     String?
  isAnonymous Boolean  @default(false) // oculta el nombre públicamente
  isApproved  Boolean  @default(true) // moderación opcional
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([userId, productId]) // una reseña por usuario/producto
  @@index([productId])
  @@map("reviews")
}
